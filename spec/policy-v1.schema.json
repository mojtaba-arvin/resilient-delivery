{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilient-delivery.dev/spec/policy/v1",
  "title": "Owner-signed delivery policy bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "issued_at", "expires_at", "origins", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "integer", "minimum": 1 },
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 8 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "contentEncoding": "base64", "minLength": 1 }
      }
    }
  }
}
